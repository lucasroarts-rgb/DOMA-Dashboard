# Copy this file to .env and fill in real values. .env is git-ignored - never commit it.

# --- Google Search Console ---
# Must match exactly how the property is registered in Search Console:
# "https://dentalofficemanagers.com/" (URL-prefix) or "sc-domain:dentalofficemanagers.com" (Domain property).
GSC_SITE_URL=https://dentalofficemanagers.com/

# --- Google Analytics 4 ---
# Admin > Property details > Property ID (numeric).
GA4_PROPERTY_ID=

# Shared by GSC + GA4: path to the Google Cloud service account JSON key.
# The same service account must be added as:
#  - a Viewer on the GA4 property (Admin > Property Access Management)
#  - a Restricted user on the Search Console property (Settings > Users and permissions)
GA4_SERVICE_ACCOUNT_FILE=google_service_account.json

# --- GoHighLevel ("Twilead") ---
# Settings > Private Integrations > Create new integration (scope: View Contacts).
GHL_API_KEY=
GHL_LOCATION_ID=

# --- Meta (Facebook Page + Instagram Business, organic only - no Ads API) ---
# See README.md "Meta organic setup" for how these are generated via the
# Graph API Explorer (Page Access Token exchanged for a long-lived one).
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_ACCOUNT_ID=

# --- Google PageSpeed Insights (Lighthouse mobile audit, runs daily via scripts/sync_pagespeed.py) ---
# Same Google Cloud project as GA4/GSC: enable "PageSpeed Insights API" and create an API key
# (Credentials > Create Credentials > API key), no OAuth/service-account needed. The public
# no-key quota is shared globally and can hit 0/day, so this key is required.
PAGESPEED_API_KEY=

# --- WordPress (SEO fixes via REST API + Application Password) ---
# Users > Profile > Application Passwords. Use the application password, never the real login password.
WP_URL=
WP_USERNAME=
WP_APP_PASSWORD=

# --- Ahrefs (Site Audit issues + competitors, aba "Competitors" - see README) ---
# Account Settings > API Access. Project ID is the numeric id in the Ahrefs
# Site Audit URL for this project (app.ahrefs.com/site-audit/<id>/...).
AHREFS_API_KEY=
AHREFS_PROJECT_ID=

# --- Daily SEO email digest (scripts/send_seo_digest.py) ---
# For Gmail: myaccount.google.com/apppasswords - an App Password, never the
# account's real password. Other providers: use their SMTP host/port instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# --- Publishing ---
GITHUB_PAGES_URL=
AUTO_PUBLISH=true

# --- Local admin (reserved for future write endpoints, not required today) ---
ADMIN_USER=doma
ADMIN_PASSWORD=
